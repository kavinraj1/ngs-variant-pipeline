process {
    withName: 'FASTQC' {
        publishDir = [path: { "${params.outdir}/qc/fastqc" }, mode: 'copy']
    }
    withName: 'FASTP' {
        publishDir = [path: { "${params.outdir}/qc/fastp" }, mode: 'copy', pattern: '*.{json,html}']
    }
    withName: 'GATK4_MARKDUPLICATES' {
        publishDir = [path: { "${params.outdir}/qc/markduplicates" }, mode: 'copy', pattern: '*.metrics.txt']
    }
    withName: 'GATK4_SORTSAM' {
        publishDir = [path: { "${params.outdir}/alignment" }, mode: 'copy']
    }
    withName: 'SAMTOOLS_STATS' {
        publishDir = [path: { "${params.outdir}/qc/samtools" }, mode: 'copy']
    }
    withName: 'GATK4_HAPLOTYPECALLER' {
        publishDir = [path: { "${params.outdir}/variants/raw" }, mode: 'copy']
    }
    withName: 'GATK4_VARIANTFILTRATION' {
        publishDir = [path: { "${params.outdir}/variants/filtered" }, mode: 'copy']
    }
    withName: 'BCFTOOLS_STATS' {
        publishDir = [path: { "${params.outdir}/qc/bcftools" }, mode: 'copy']
    }
    withName: 'RTG_VCFEVAL' {
        publishDir = [path: { "${params.outdir}/benchmark" }, mode: 'copy', pattern: '*{_vcfeval,.benchmark.tsv}']
    }
    withName: 'MULTIQC' {
        publishDir = [path: { "${params.outdir}/multiqc" }, mode: 'copy']
    }
}
