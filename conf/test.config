// Small HG002 dataset (chr20:10,000,000-10,200,000). Create it first with:
//   scripts/fetch_test_data.sh chr20:10000000-10200000 test
params {
    input     = "${projectDir}/data/test/samplesheet.csv"
    fasta     = "${projectDir}/data/ref/chr20.fa"
    intervals = "${projectDir}/data/test/region.bed"
    truth_vcf = "${projectDir}/data/test/truth.vcf.gz"
    truth_bed = "${projectDir}/data/test/truth.bed"
}

process.resourceLimits = [cpus: 4, memory: 8.GB, time: 1.h]
